{
  "expo": {
    "name": "Luma",
    "slug": "luma-messenger",
    "version": "0.3.12",
    "orientation": "default",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "scheme": "luma",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "app.luma.messenger",
      "infoPlist": {
        "NSCameraUsageDescription": "Luma utilise la caméra pour les appels vidéo et la lecture de QR codes.",
        "NSMicrophoneUsageDescription": "Luma utilise le micro pendant les appels que vous acceptez."
      },
      "buildNumber": "14"
    },
    "android": {
      "package": "app.luma.messenger",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#11172b"
      },
      "permissions": [
        "CAMERA",
        "RECORD_AUDIO",
        "MODIFY_AUDIO_SETTINGS",
        "FOREGROUND_SERVICE",
        "FOREGROUND_SERVICE_MICROPHONE",
        "INTERNET"
      ],
      "versionCode": 15
    },
    "plugins": [
      "expo-sharing",
      "expo-asset",
      [
        "expo-audio",
        {
          "enableBackgroundPlayback": true,
          "enableBackgroundRecording": true
        }
      ]
    ]
  }
}
