{
  "expo": {
    "name": "Luma",
    "slug": "luma-messenger",
    "version": "0.3.8",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "scheme": "luma",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "app.luma.messenger",
      "infoPlist": {
        "NSCameraUsageDescription": "Luma utilise la caméra pour les appels vidéo et la lecture de QR codes.",
        "NSMicrophoneUsageDescription": "Luma utilise le micro pendant les appels que vous acceptez."
      },
      "buildNumber": "11"
    },
    "android": {
      "package": "app.luma.messenger",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#11172b"
      },
      "permissions": [
        "CAMERA",
        "RECORD_AUDIO",
        "MODIFY_AUDIO_SETTINGS"
      ],
      "versionCode": 11
    },
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#11172b"
    },
    "plugins": [
      "expo-sharing"
    ]
  }
}
